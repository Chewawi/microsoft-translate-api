{
  "name": "microsoft-translate-api",
  "version": "2.0.0",
  "description": "A simple, powerful and free API for Microsoft Translator for Node.js",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/generate-langs.js && unbuild",
    "prepare": "node scripts/generate-langs.js && unbuild",
    "prepack": "node scripts/generate-langs.js && unbuild",
    "generate:langs": "node scripts/generate-langs.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Chewawi/microsoft-translate-api.git"
  },
  "keywords": [
    "bing",
    "microsoft",
    "translator",
    "trans",
    "api",
    "javascript",
    "typescript",
    "free",
    "node",
    "translate",
    "azure"
  ],
  "author": "Chewawi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Chewawi/microsoft-translate-api/issues"
  },
  "homepage": "https://github.com/Chewawi/microsoft-translate-api",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.31.1",
    "@types/bun": "^1.1.16",
    "@types/node": "^22.10.6",
    "typescript": "^5.7.3",
    "unbuild": "^3.3.1"
  },
  "packageManager": "bun@1.3.14"
}
